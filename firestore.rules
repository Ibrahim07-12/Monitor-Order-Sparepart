rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Spareparts collection
    match /spareparts/{sparepartId} {
      // Allow read if user is authenticated
      allow read: if request.auth != null;
      
      // Allow write (create, update, delete) if user is authenticated
      allow write: if request.auth != null;
    }

    // Allow read/write to appSettings/ui so UI flags (like autoScroll) can be updated
    // NOTE: This is permissive and should be secured (only allow admin) for production.
    match /appSettings/ui {
      allow read: if true;
      allow write: if true;
    }

    // Monitoring settings collection (thresholds, etc)
    match /monitoringSettings/{settingId} {
      // Allow read if user is authenticated
      allow read: if request.auth != null;
      
      // Allow write if user is authenticated
      allow write: if request.auth != null;
    }

    // Sensor readings collection (real-time & historical data)
    match /sensorReadings/{readingId} {
      // Allow read if user is authenticated
      allow read: if request.auth != null;
      
      // Allow write if user is authenticated (untuk insert dari hardware/simulator)
      allow write: if request.auth != null;
    }

    // Daily aggregates for bar charts
    match /sensorDailyAggregates/{aggregateId} {
      // Allow read if user is authenticated
      allow read: if request.auth != null;
      
      // Allow write if user is authenticated
      allow write: if request.auth != null;
    }

    // Raw sensor data for ML training (1-3 minggu collection period)
    match /rawSensorData/{dataId} {
      // Allow read if user is authenticated
      allow read: if request.auth != null;
      
      // Allow write if user is authenticated (dari ESP32/Arduino)
      allow write: if request.auth != null;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
